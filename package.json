{
  "name": "frontend_client_lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "scripts": {
    "cbh:toolchain": "node scripts/ci/verify-toolchain.mjs",
    "cbh:ratchet:test": "node --test scripts/ci/cbh-ratchet-core.node-tests.mjs scripts/ci/current-ratchet-normalizers.node-tests.mjs",
    "cbh:ratchet:verify": "node scripts/ci/verify-baselines.mjs",
    "cbh:protected": "vitest run --configLoader runner src/assessments/FacilityAssessmentJourneysPage.test.tsx src/oets/OetsRenderer.test.tsx src/executive-findings/ExecutivePresentationPage.test.tsx src/executive-presentation/ExecutivePresentationAuthoringPage.test.tsx src/executive-presentation/executivePresentationPagination.test.ts",
    "cbh:ratchet:current:test": "node scripts/ci/run-current-ratchet.mjs frontend-tests",
    "cbh:ratchet:current:lint": "node scripts/ci/run-current-ratchet.mjs frontend-lint",
    "cbh:ratchet:current": "npm run cbh:ratchet:current:test && npm run cbh:ratchet:current:lint",
    "dev": "vite --configLoader runner",
    "build": "tsc -p tsconfig.json && vite build --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
